# ==========================================
# TravelAI Frontend Environment Variables (Vercel)
# ==========================================

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
VITE_GOOGLE_GEMINI_AI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Backend URL deployed on Render (without trailing slash)
# Example: https://travel-ai-backend.onrender.com
VITE_BACKEND_URL=https://your-backend-api.onrender.com

# Optional explicit API URL (defaults to VITE_BACKEND_URL + /api)
# VITE_API_URL=https://your-backend-api.onrender.com/api
