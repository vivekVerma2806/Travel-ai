# ==========================================
# TravelAI Backend Environment Variables
# ==========================================

# Port to listen on (Render automatically provides PORT in production)
PORT=5001

# MongoDB Connection String (Atlas URI or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/travelai?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/travelai?retryWrites=true&w=majority

# Secret key used to encrypt express-session cookies (generate a random string)
SESSION_SECRET=your_production_session_secret_key_minimum_32_characters

# Deployment Environment ('development' or 'production')
NODE_ENV=production

# Frontend URL deployed on Vercel (used by CORS and Socket.IO)
# Example: https://travel-ai.vercel.app
CLIENT_URL=https://your-frontend-app.vercel.app

# Optional: Comma-separated list of additional allowed origins
# ALLOWED_ORIGINS=https://your-custom-domain.com,https://travel-ai.vercel.app
